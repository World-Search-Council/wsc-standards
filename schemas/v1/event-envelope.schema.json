{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.worldsearchcouncil.org/v1/event-envelope.schema.json",
  "title": "WSC Telemetry Event Envelope",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "e", "p"],
        "properties": {
          "t": {
            "type": "integer",
            "description": "Unix timestamp in seconds"
          },
          "e": {
            "type": "string",
            "enum": [
              "pageview",
              "purchase",
              "bot_hit",
              "click",
              "download",
              "time_on_page",
              "view_item",
              "add_to_cart",
              "custom"
            ],
            "description": "Canonical WSC event type"
          },
          "p": {
            "type": "string",
            "maxLength": 2048,
            "description": "URL path"
          },
          "r": {
            "type": "string",
            "description": "HTTP Referrer URL"
          },
          "m": {
            "type": "object",
            "description": "Event metadata map",
            "default": {}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
