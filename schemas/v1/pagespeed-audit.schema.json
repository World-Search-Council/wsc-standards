{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WSCPageSpeedAuditReport",
  "description": "Schema for WSC SpeedSentinel Core Web Vitals lab and field performance audits",
  "type": "object",
  "required": [
    "status",
    "url",
    "strategy",
    "performance_score",
    "overall_rating",
    "metrics",
    "asset_summary",
    "action_items",
    "audited_at"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error"]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "strategy": {
      "type": "string",
      "enum": ["mobile", "desktop"]
    },
    "performance_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "overall_rating": {
      "type": "string",
      "enum": ["GOOD", "NEEDS_IMPROVEMENT", "POOR"]
    },
    "metrics": {
      "type": "object",
      "required": ["lcp", "cls", "fcp", "ttfb", "tbt"],
      "properties": {
        "lcp": { "$ref": "#/$defs/Metric" },
        "cls": { "$ref": "#/$defs/Metric" },
        "fcp": { "$ref": "#/$defs/Metric" },
        "ttfb": { "$ref": "#/$defs/Metric" },
        "tbt": { "$ref": "#/$defs/Metric" }
      }
    },
    "asset_summary": {
      "type": "object",
      "required": ["total_requests", "total_weight_kb", "breakdown_kb", "dom_nodes"],
      "properties": {
        "total_requests": { "type": "integer" },
        "total_weight_kb": { "type": "number" },
        "breakdown_kb": {
          "type": "object",
          "properties": {
            "html": { "type": "number" },
            "css": { "type": "number" },
            "javascript": { "type": "number" },
            "images": { "type": "number" },
            "fonts": { "type": "number" },
            "other": { "type": "number" }
          }
        },
        "dom_nodes": { "type": "integer" },
        "large_images": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "title", "description"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "INFO"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "potential_savings": { "type": ["string", "null"] }
        }
      }
    },
    "audited_at": {
      "type": "integer",
      "description": "Unix timestamp in seconds"
    }
  },
  "$defs": {
    "Metric": {
      "type": "object",
      "required": ["name", "value", "unit", "rating", "description"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "rating": { "type": "string", "enum": ["GOOD", "NEEDS_IMPROVEMENT", "POOR"] },
        "description": { "type": "string" }
      }
    }
  }
}
